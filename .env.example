# Model providers (OpenAI-compatible). At least one required for eval/training.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional additional providers
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Default model for local eval (override via CLI --model)
DEFAULT_MODEL=openai/gpt-4.1-mini

# Eval guardrails
EVAL_MAX_COST_USD=2.00
EVAL_MAX_CONCURRENCY=8

# Sandbox (Phase 08)
SANDBOX_HOST=0.0.0.0
SANDBOX_PORT=8080
SANDBOX_MAX_TASKS_PER_RUN=50
SANDBOX_RATE_LIMIT_PER_MINUTE=30

# Pinned artifacts (recorded in every run config.json)
RULESET_VERSION=1.0.0
SCHEMA_VERSION=1.0.0
